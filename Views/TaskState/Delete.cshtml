@model TaskFlowMvc.Models.TaskState

@{
    ViewData["Title"] = "Delete Task State";
}

<h2>Delete Task State</h2>

<div class="alert alert-warning">
    <h5>Are you sure you want to delete this task state?</h5>
</div>

<div class="mb-3">
    <strong>Name:</strong>
    @Model.Name
</div>

<form asp-action="DeleteConfirmed"
      asp-route-id="@Model.Id"
      method="post">
      <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>