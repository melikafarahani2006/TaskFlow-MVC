@model IEnumerable<TaskFlowMvc.Models.Tag>

@{
    ViewData["Title"] = "Tags";
}

<h2>Tags</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">
        Create Tag
    </a>
</p>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Name</th>
            <th>Color</th>
            <th>Created At</th>
            <th>Updated At</th>
            <th width="180">Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Name</td>

                <td>
                    <span class="badge"
                          style="background-color:@item.Color; width:20px; height:20px; display:inline-block;">
                    </span>
                </td>

                <td>
                    @item.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                </td>

                <td>
                    @(item.UpdatedAt.HasValue
                        ? item.UpdatedAt.Value.ToString("yyyy/MM/dd HH:mm")
                        : "-")
                </td>

                <td>

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>