@model IEnumerable<TaskFlowMvc.Models.TaskItem>

<h2>Tasks</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Create
    </a>
</p>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Title</th>
            <th>Project</th>
            <th>Status</th>
            <th>Tags</th>
            <th>Created At</th>
            <th>Updated At</th>
            <th width="180">Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Title</td>

                <td>@item.Project.Name</td>

                <td>@item.TaskState.Name</td>

                <td>
                    @foreach (var itemTag in item.TaskItemTags)
                    {
                        <span class="badge bg-secondary me-1">
                            @itemTag.Tag.Name
                        </span>
                    }
                </td>

                <td>
                    @item.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                </td>

                <td>
                    @(item.UpdatedAt.HasValue
                        ? item.UpdatedAt.Value.ToString("yyyy/MM/dd HH:mm")
                        : "-")
                </td>

                <td>

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>