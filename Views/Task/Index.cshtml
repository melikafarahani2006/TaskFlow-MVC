@model IEnumerable<TaskFlowMvc.Models.Task>

@{
    ViewData["Title"] = "Tasks";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Tasks</h2>
            <p class="text-muted">
                Manage all tasks across your projects.
            </p>
        </div>

        <div>

            <a asp-action="Create"
               class="btn btn-primary">

                + New Task

            </a>

            <a asp-controller="Report"
               asp-action="TaskReport"
               asp-route-projectId="@ViewBag.ProjectId"
               class="btn btn-success">

                📄 Report

            </a>

        </div>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <table class="table align-middle table-hover">

                <thead class="table-light">

                    <tr>

                        <th>Title</th>

                        <th>Project</th>

                        <th>Status</th>

                        <th>Tags</th>

                        <th>Created</th>
                        <th>Updated</th>

                        <th width="180">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td class="fw-semibold">

                                @item.Title

                            </td>

                            <td>

                                @item.Project.Name

                            </td>

                            <td>

                                <span class="badge rounded-pill bg-primary">

                                    @item.TaskState.Name

                                </span>

                            </td>

                            <td>

                                @foreach (var tag in item.TaskTags)
                                {
                                    <span class="badge me-1"
                                          style="background:@tag.Tag.Color;color:white">

                                        @tag.Tag.Name

                                    </span>
                                }

                            </td>

                            <td>

                                @item.CreatedAt.ToString("dd MMM yyyy")

                            </td>
                            <td>
                                @(item.UpdatedAt.HasValue ? item.UpdatedAt.Value.ToString("dd MMM yyyy") : "-")
                            </td>

                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-warning btn-sm">

                                    Edit

                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-danger btn-sm">

                                    Delete

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>