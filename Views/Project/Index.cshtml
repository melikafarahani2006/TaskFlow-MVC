@model IEnumerable<TaskFlowMvc.Models.Project>

@{
    ViewData["Title"] = "Projects";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Projects</h2>
            <p class="text-muted">
                Manage projects inside your workspace.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            + New Project
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="row g-4">

        @foreach (var item in Model)
        {
            <div class="col-md-6 col-xl-4">

                <div class="card shadow-sm border-0 project-card h-100">

                    <div class="card-body">

                        <div class="d-flex align-items-center mb-3">

                            <div class="project-icon me-3">
                                📁
                            </div>

                            <div>

                                <h4 class="fw-bold mb-0">
                                    @item.Name
                                </h4>

                                <small class="text-muted">
                                    @item.Workspace.Name
                                </small>

                            </div>

                        </div>

                        <p class="text-muted">

                            @(string.IsNullOrWhiteSpace(item.Description)
                                ? "No description"
                                : item.Description)

                        </p>

                        <hr />

                        <div class="d-flex justify-content-between">

                            <small class="text-muted">
                                Created
                            </small>

                            <small class="fw-semibold">
                                @item.CreatedAt.ToString("yyyy/MM/dd")
                            </small>

                            <small class="text-muted">
                                Updated
                            </small>

                            <small class="fw-semibold">
                                    @(item.UpdatedAt.HasValue ? item.UpdatedAt.Value.ToString("dd MMM yyyy") : "-")
                            </small>

                        </div>

                    </div>

                    <div class="card-footer bg-white border-0">

                        <div class="d-flex justify-content-between">

                            <a asp-controller="Task"
                               asp-action="Index"
                               asp-route-projectId="@item.Id"
                               class="btn btn-outline-primary btn-sm">

                                Open →

                            </a>

                            <div>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">

                                    Edit

                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm">

                                    Delete

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>

<style>

    .project-card {
        border-radius: 18px;
        transition: .25s;
    }

        .project-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 14px 30px rgba(0,0,0,.12) !important;
        }

    .project-icon {
        width: 58px;
        height: 58px;
        border-radius: 14px;
        background: #EEF4FF;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 28px;
    }

</style>