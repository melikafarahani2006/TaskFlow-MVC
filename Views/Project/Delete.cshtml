@model TaskFlowMvc.Models.Project
<h2>Delete Project</h2>

<h4>Are you sure?</h4>

<hr />

<dl class="row">

    <dt class="col-sm-2">
        Name
    </dt>

    <dd class="col-sm-10">
        @Model.Name
    </dd>

    <dt class="col-sm-2">
        Description
    </dt>

    <dd class="col-sm-10">
        @Model.Description
    </dd>

</dl>

<form asp-action="DeleteConfirmed"
      method="post">
           <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input asp-for="Id"
           type="hidden" />

    <button class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>