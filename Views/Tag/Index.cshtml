@model IEnumerable<TaskFlowMvc.Models.Tag>

@{
    ViewData["Title"] = "Tags";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Tags</h2>
            <p class="text-muted">
                Organize tasks using colorful labels.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            + New Tag
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="row g-4">

        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 col-xl-3">

                <div class="card shadow-sm border-0 tag-card h-100">

                    <div class="card-body">

                        <div class="d-flex align-items-center mb-3">

                            <div class="tag-circle me-3"
                                 style="background:@item.Color">
                            </div>

                            <h5 class="fw-bold mb-0">
                                @item.Name
                            </h5>

                        </div>

                        @* <small class="text-muted d-block mb-3">

                            Color :
                            <code>@item.Color</code>

                        </small> *@

                        <small class="text-muted">

                            Created

                            @item.CreatedAt.ToString("dd MMM yyyy")

                        </small>

                    </div>

                    <div class="card-footer bg-white border-0">

                        <div class="d-flex justify-content-between">

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-warning btn-sm">

                                Edit

                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-danger btn-sm">

                                Delete

                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>

<style>

    .tag-card {
        border-radius: 18px;
        transition: .25s;
    }

        .tag-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 28px rgba(0,0,0,.15) !important;
        }

    .tag-circle {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 2px solid #eee;
    }

    code {
        font-size: .85rem;
    }

</style>